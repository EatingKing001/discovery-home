map_hash_bucket_size 128;

# 根据环境变量 env 设置 CSP 白名单变量
map "${env}" $csp_frame_ancestors {
    "prod"    "https://finding.intern-ai.org.cn";
    "staging" "https://discovery-staging.intern-ai.org.cn";
    "dev"     "https://discovery-dev.intern-ai.org.cn";
    default   "https://discovery.intern-ai.org.cn";
}

# 允许从哪些「业务父域」跨域拉取本站点静态资源（JS/CSS/字体/图片等）
map "${env}:${http_origin}" $cors_allow_origin {
    "prod:https://d.intern-ai.org.cn" "https://d.intern-ai.org.cn";
    "prod:https://discovery.intern-ai.org.cn" "https://discovery.intern-ai.org.cn";
    "prod:https://finding.intern-ai.org.cn" "https://finding.intern-ai.org.cn";
    "staging:https://discovery-staging.intern-ai.org.cn" "https://discovery-staging.intern-ai.org.cn";
    "dev:https://discovery-dev.intern-ai.org.cn" "https://discovery-dev.intern-ai.org.cn";
    "dev:https://discovery-test1-dev.intern-ai.org.cn" "https://discovery-test1-dev.intern-ai.org.cn";
    default "";
}
